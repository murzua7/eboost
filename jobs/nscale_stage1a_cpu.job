#!/bin/bash
#SBATCH --job-name=matzua-eboost-s1a-cpu
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=12:00:00
#SBATCH --output=%x-%A_%a.out
# Stage 1a pilot on F (development data only), processors only: no card.
# The pilot's datasets are small (2k to 100k rows), and six runs sharing one
# H200 kept it at 99% busy while each run went about six times slower than a
# 4-thread laptop processor (letter's 50-config search: over 4 h against 43 min).
# One array task runs scripts/stage1a.py for line SLURM_ARRAY_TASK_ID+1 of ITEMS.
# Usage: sbatch --array=0-<n-1>%<at once> nscale_stage1a_cpu.job \
#          <bundle.tar.gz> <sha256> <commit> <data dir> <items file> <out dir>
set -uo pipefail
umask 027
TAR=${1:?bundle}; WANT=${2:?sha256}; COMMIT=${3:?commit}; DATA=${4:?data}; ITEMS=${5:?items}; OUT=${6:?out}
THREADS=$SLURM_CPUS_PER_TASK
GOT=$(sha256sum "$TAR" | cut -c1-64)
[ "$GOT" = "$WANT" ] || { echo "BUNDLE_REFUSED: sha256 $GOT, expected $WANT"; exit 2; }
PY=$HOME/envs/eboost-py312/bin/python
[ -x "$PY" ] || { echo "ENV_MISSING $PY"; exit 2; }
[ -f "$DATA/MANIFEST.json" ] || { echo "DATA_MISSING $DATA"; exit 2; }
LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "$ITEMS")
[ -n "$LINE" ] || { echo "NO_ITEM at line $((SLURM_ARRAY_TASK_ID + 1)) of $ITEMS"; exit 2; }
set -- $LINE; TASK=$1; SEED=$2
[ ! -e "$OUT/task${TASK}_seed${SEED}.jsonl" ] || { echo "OUTPUT_EXISTS task $TASK seed $SEED"; exit 2; }
W=$(mktemp -d "${TMPDIR:-/tmp}/eboost-$SLURM_JOB_ID-XXXX")
trap 'rm -rf "$W"' EXIT
tar xzf "$TAR" -C "$W" || exit 2
mkdir -p "$OUT/logs"
export PYTHONPATH=$W/src EBOOST_COMMIT=$COMMIT PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=$THREADS
echo "start $(date -u +%FT%TZ) host $(hostname) commit $COMMIT task $TASK seed $SEED threads $THREADS"
t0=$(date +%s)
"$PY" "$W/scripts/stage1a.py" --data "$DATA" --task "$TASK" --seed "$SEED" --out "$OUT" \
  --device cpu --nthread "$THREADS" > "$OUT/logs/task${TASK}_seed${SEED}.log" 2>&1
rc=$?
echo "ITEM task $TASK seed $SEED exit $rc seconds $(( $(date +%s) - t0 ))"
exit $rc
